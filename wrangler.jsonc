{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "miles158",
	"compatibility_date": "2026-05-20",
	"compatibility_flags": ["nodejs_als"],
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	// Non-secret config. EMAIL_PROVIDER=mock until a real provider (Resend/SES) +
	// secrets (RESEND_API_KEY etc.) are added. Set PUBLIC_BASE_URL to the real
	// domain in production.
	"vars": {
		"EMAIL_PROVIDER": "mock",
		"EMAIL_FROM": "MILES 158 <noreply@mail.miles158.com>",
		"EMAIL_REPLY_TO": "support@miles158.com",
		"STAFF_NOTIFY_TO": "ops@miles158.com",
		"PUBLIC_BASE_URL": "https://miles158.pages.dev"
	},
	// D1 (SQLite at edge) — reservation persistence + inventory double-booking guard.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "miles158-db",
			"database_id": "365c5e52-48fd-40af-b4b5-9c1b5f0e5f8e",
			"migrations_dir": "migrations"
		}
	]
}
